<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="x-apple-disable-message-reformatting">
  <title>{{subject}}</title>
  <style>
    body, table, td, p, a { margin: 0; padding: 0; border: 0; font-size: 100%; line-height: 1.5; }
    body {
      background-color: #fafafa;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    table { border-collapse: collapse; mso-table-lspace: 0; mso-table-rspace: 0; }
    img { border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; display: block; }
    .ExternalClass, .ReadMsgBody { width: 100%; background-color: #fafafa; }
    .ExternalClass, .ExternalClass p, .ExternalClass span, .ExternalClass td, .ExternalClass div { line-height: 100%; }
    a { color: #0a0a0a; }
    @media only screen and (max-width: 600px) {
      .container { width: 100% !important; }
      .mobile-pad { padding-left: 28px !important; padding-right: 28px !important; }
    }
  </style>
</head>
<body style="background-color: #fafafa; margin: 0; padding: 0;">
  <center style="width: 100%; table-layout: fixed; background-color: #fafafa;">
    <table align="center" width="100%" cellpadding="0" cellspacing="0" role="presentation" style="max-width: 600px; background-color: #fafafa;">
      <tr>
        <td align="center" style="padding: 48px 16px 40px;">

          <!-- CARD -->
          <table class="container" width="100%" cellpadding="0" cellspacing="0" role="presentation"
            style="max-width: 560px; background-color: #ffffff; border-radius: 10px; overflow: hidden; border: 1px solid #ececec;">
            <tr>
              <td>

                {{> header}}

                <!-- CONTENT -->
                <table width="100%" cellpadding="0" cellspacing="0" role="presentation">
                  <tr>
                    <td class="mobile-pad" style="padding: 40px 48px 44px;">

                      {{> greeting firstName=firstName}}

                      {{> @partial-block}}

                    </td>
                  </tr>
                </table>

              </td>
            </tr>
          </table>

          {{> footer}}

        </td>
      </tr>
    </table>
  </center>
</body>
</html>
