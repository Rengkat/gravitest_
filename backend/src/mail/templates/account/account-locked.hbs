{{#> layouts/base title="Account temporarily locked" subject="Your account has been temporarily locked — Gravitest"}}

  <p style="font-size: 15px; color: #3f3f46; line-height: 1.7; margin: 0 0 8px;">
    Your Gravitest account has been temporarily locked due to multiple failed sign-in attempts.
  </p>

  {{> info-alert message="For your security, the account will remain locked for 30 minutes. After that you may attempt to sign in again, or reset your password now." type="neutral"}}

  {{> action-button buttonText="Reset your password" buttonUrl=resetUrl}}

{{/layouts/base}}
