{{#> layouts/base title="Welcome to Gravitest" subject="Welcome to Gravitest — your preparation starts now"}}

  <p style="font-size: 15px; color: #3f3f46; line-height: 1.7; margin: 0 0 20px;">
    Your account is ready. We&rsquo;re glad to have you on Gravitest &mdash; Nigeria&rsquo;s dedicated exam preparation platform, covering secondary school exams like JAMB, WAEC and NECO, as well as professional certification exams like ICAN, CIBN and NMCN, and more.
  </p>

  <table width="100%" cellpadding="0" cellspacing="0" role="presentation"
    style="background-color: #fafafa; border: 1px solid #ececec; border-radius: 6px; margin: 0 0 28px;">
    <tr>
      <td style="padding: 20px 24px;">
        <p style="font-size: 11px; font-weight: 600; color: #a1a1aa; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 14px;">
          What&rsquo;s available to you
        </p>
        <table cellpadding="0" cellspacing="0" role="presentation" style="width: 100%;">
          <tr>
            <td style="font-size: 13px; color: #3f3f46; padding: 5px 0; line-height: 1.5;">
              <span style="display: inline-block; width: 4px; height: 4px; background-color: #0a0a0a; border-radius: 50%; vertical-align: middle; margin-right: 10px;"></span>
              CBT practice across secondary school exams (JAMB, WAEC, NECO and more) and professional exams (ICAN, CIBN, NMCN and more)
            </td>
          </tr>
          <tr>
            <td style="font-size: 13px; color: #3f3f46; padding: 5px 0; line-height: 1.5;">
              <span style="display: inline-block; width: 4px; height: 4px; background-color: #0a0a0a; border-radius: 50%; vertical-align: middle; margin-right: 10px;"></span>
              Sabi-Tutor &mdash; AI-powered instant explanations
            </td>
          </tr>
          <tr>
            <td style="font-size: 13px; color: #3f3f46; padding: 5px 0; line-height: 1.5;">
              <span style="display: inline-block; width: 4px; height: 4px; background-color: #0a0a0a; border-radius: 50%; vertical-align: middle; margin-right: 10px;"></span>
              Weak topic tracking and performance analytics
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>

  {{> action-button buttonText="Go to your dashboard" buttonUrl=dashboardUrl}}

{{/layouts/base}}
