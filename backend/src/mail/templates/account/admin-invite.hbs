{{#> layouts/base title="You've been invited as an admin" subject="You've been invited to Gravitest as an administrator"}}

  <p style="font-size: 15px; color: #3f3f46; line-height: 1.7; margin: 0 0 8px;">
    {{#if invitedByName}}{{invitedByName}} has invited you{{else}}You have been invited{{/if}} to join Gravitest as an administrator.
  </p>
  <p style="font-size: 14px; color: #71717a; line-height: 1.7; margin: 0 0 24px;">
    Finish setting up your account to get access to the admin dashboard.
  </p>

  <table width="100%" cellpadding="0" cellspacing="0" role="presentation"
    style="background-color: #fafafa; border: 1px solid #ececec; border-radius: 6px; margin: 0 0 4px;">
    <tr>
      <td style="padding: 16px 20px;">
        <table cellpadding="0" cellspacing="0" role="presentation">
          <tr>
            <td style="font-size: 12px; color: #a1a1aa; padding: 4px 0; width: 90px; vertical-align: top;">Name</td>
            <td style="font-size: 13px; color: #27272a; padding: 4px 0; font-weight: 500;">{{firstName}} {{lastName}}</td>
          </tr>
          {{#if phone}}
          <tr>
            <td style="font-size: 12px; color: #a1a1aa; padding: 4px 0; width: 90px; vertical-align: top;">Phone</td>
            <td style="font-size: 13px; color: #27272a; padding: 4px 0; font-weight: 500;">{{phone}}</td>
          </tr>
          {{/if}}
          <tr>
            <td style="font-size: 12px; color: #a1a1aa; padding: 4px 0; width: 90px; vertical-align: top;">Role</td>
            <td style="font-size: 13px; color: #27272a; padding: 4px 0; font-weight: 500;">{{role}}</td>
          </tr>
        </table>
      </td>
    </tr>
  </table>

  {{> action-button buttonText="Accept invite & set up account" buttonUrl=inviteUrl}}

  <table
    width='100%'
    cellpadding='0'
    cellspacing='0'
    role='presentation'
    style='border-left: 3px solid #d4d4d8; background-color: #fafafa; border-radius: 0 4px 4px 0; margin: 24px 0;'
  >
    <tr>
      <td style='padding: 14px 18px;'>
        <p style='font-size: 13px; color: #52525b; margin: 0; line-height: 1.6;'>
          This invite link expires in <strong style="color: #27272a; font-weight: 600;">{{expiryDays}} days</strong> and can only be used once. If you weren&rsquo;t expecting this, you can safely ignore this email.
        </p>
      </td>
    </tr>
  </table>

{{/layouts/base}}
