{{#> layouts/base title="Payment receipt" subject="Your payment receipt — Gravitest"}}

  <p style="font-size: 15px; color: #3f3f46; line-height: 1.7; margin: 0 0 24px;">
    Thank you. Your payment has been received and your receipt is below.
  </p>

  <table width="100%" cellpadding="0" cellspacing="0" role="presentation"
    style="background-color: #fafafa; border: 1px solid #ececec; border-radius: 6px; margin: 0 0 28px;">
    <tr>
      <td style="padding: 20px 24px;">
        <p style="font-size: 11px; font-weight: 600; color: #a1a1aa; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 14px;">
          Payment details
        </p>
        <table cellpadding="0" cellspacing="0" role="presentation" style="width: 100%;">
          <tr>
            <td style="font-size: 12px; color: #a1a1aa; padding: 5px 0; width: 120px; vertical-align: top;">Description</td>
            <td style="font-size: 13px; color: #27272a; padding: 5px 0; font-weight: 500;">{{description}}</td>
          </tr>
          <tr>
            <td style="font-size: 12px; color: #a1a1aa; padding: 5px 0; width: 120px; vertical-align: top;">Amount</td>
            <td style="font-size: 13px; color: #0a0a0a; padding: 5px 0; font-weight: 700;">&#8358;{{amount}}</td>
          </tr>
          <tr>
            <td style="font-size: 12px; color: #a1a1aa; padding: 5px 0; width: 120px; vertical-align: top;">Date</td>
            <td style="font-size: 13px; color: #27272a; padding: 5px 0; font-weight: 500;">{{date}}</td>
          </tr>
          <tr>
            <td style="font-size: 12px; color: #a1a1aa; padding: 5px 0; width: 120px; vertical-align: top;">Reference</td>
            <td style="font-size: 13px; color: #27272a; padding: 5px 0; font-family: 'Courier New', monospace;">{{reference}}</td>
          </tr>
          <tr>
            <td style="font-size: 12px; color: #a1a1aa; padding: 5px 0; width: 120px; vertical-align: top;">Method</td>
            <td style="font-size: 13px; color: #27272a; padding: 5px 0; font-weight: 500;">{{paymentMethod}}</td>
          </tr>
        </table>
      </td>
    </tr>
  </table>

  {{> action-button buttonText="Download receipt" buttonUrl=invoiceUrl}}

{{/layouts/base}}
