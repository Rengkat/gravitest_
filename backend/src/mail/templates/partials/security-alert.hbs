<!-- SECURITY DETAILS -->
<table
  width='100%'
  cellpadding='0'
  cellspacing='0'
  role='presentation'
  style='border: 1px solid #ececec; border-radius: 8px; margin: 24px 0;'
>
  <tr>
    <td style='padding: 20px 24px;'>
      <p
        style='font-size: 11px; font-weight: 600; color: #a1a1aa; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 14px;'
      >{{alertMessage}}</p>
      <table
        cellpadding='0'
        cellspacing='0'
        role='presentation'
        style='width: 100%;'
      >
        {{#if deviceName}}
          <tr>
            <td style='font-size: 12px; color: #a1a1aa; padding: 4px 0; width: 80px; vertical-align: top;'>Device</td>
            <td style='font-size: 13px; color: #27272a; padding: 4px 0; font-weight: 500;'>{{deviceName}}</td>
          </tr>
        {{/if}}
        {{#if browser}}
          <tr>
            <td style='font-size: 12px; color: #a1a1aa; padding: 4px 0; width: 80px; vertical-align: top;'>Browser</td>
            <td style='font-size: 13px; color: #27272a; padding: 4px 0; font-weight: 500;'>{{browser}}</td>
          </tr>
        {{/if}}
        {{#if ipAddress}}
          <tr>
            <td style='font-size: 12px; color: #a1a1aa; padding: 4px 0; width: 80px; vertical-align: top;'>IP Address</td>
            <td style='font-size: 13px; color: #27272a; padding: 4px 0; font-weight: 500;'>{{ipAddress}}</td>
          </tr>
        {{/if}}
        {{#if time}}
          <tr>
            <td style='font-size: 12px; color: #a1a1aa; padding: 4px 0; width: 80px; vertical-align: top;'>Time</td>
            <td style='font-size: 13px; color: #27272a; padding: 4px 0; font-weight: 500;'>{{time}}</td>
          </tr>
        {{/if}}
        {{#if location}}
          <tr>
            <td style='font-size: 12px; color: #a1a1aa; padding: 4px 0; width: 80px; vertical-align: top;'>Location</td>
            <td style='font-size: 13px; color: #27272a; padding: 4px 0; font-weight: 500;'>{{location}}</td>
          </tr>
        {{/if}}
      </table>
    </td>
  </tr>
</table>
