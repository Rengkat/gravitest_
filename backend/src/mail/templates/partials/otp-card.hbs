<!-- OTP CARD -->
<table
  width='100%'
  cellpadding='0'
  cellspacing='0'
  role='presentation'
  style='border: 1px solid #ececec; border-radius: 8px; margin: 24px 0;'
>
  <tr>
    <td style='padding: 22px 24px;'>
      <p
        style='font-size: 11px; font-weight: 600; color: #a1a1aa; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 12px;'
      >Verification Code</p>

      <table cellpadding='0' cellspacing='0' role='presentation'>
        <tr>
          <td
            style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; font-size: 26px; font-weight: 700; color: #0a0a0a; letter-spacing: 7px; white-space: nowrap; line-height: 1;"
          >{{otpCode}}</td>
        </tr>
      </table>

      <p style='font-size: 12px; color: #a1a1aa; margin: 12px 0 0; line-height: 1.5;'>
        Expires in <strong style='color: #52525b; font-weight: 600;'>{{expiryMinutes}} minutes.</strong> Do not share it with anyone.
      </p>
    </td>
  </tr>
</table>
