<!-- INFO ALERT -->
{{#if (eq type 'critical')}}
  <table
    width='100%'
    cellpadding='0'
    cellspacing='0'
    role='presentation'
    style='border-left: 3px solid #dc2626; background-color: #fef7f7; border-radius: 0 4px 4px 0; margin: 24px 0;'
  >
    <tr>
      <td style='padding: 14px 18px;'>
        <p style='font-size: 13px; color: #7f1d1d; margin: 0; line-height: 1.6;'>{{message}}</p>
      </td>
    </tr>
  </table>
{{else}}
  <table
    width='100%'
    cellpadding='0'
    cellspacing='0'
    role='presentation'
    style='border-left: 3px solid #d4d4d8; background-color: #fafafa; border-radius: 0 4px 4px 0; margin: 24px 0;'
  >
    <tr>
      <td style='padding: 14px 18px;'>
        <p style='font-size: 13px; color: #52525b; margin: 0; line-height: 1.6;'>{{message}}</p>
      </td>
    </tr>
  </table>
{{/if}}
