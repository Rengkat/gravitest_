{{#> layouts/base title="Email address changed" subject="Your email address has been updated — Gravitest"}}

  <p style="font-size: 15px; color: #3f3f46; line-height: 1.7; margin: 0 0 24px;">
    The email address on your Gravitest account has been updated.
  </p>

  <table width="100%" cellpadding="0" cellspacing="0" role="presentation"
    style="background-color: #fafafa; border: 1px solid #ececec; border-radius: 6px; margin: 0 0 4px;">
    <tr>
      <td style="padding: 16px 20px;">
        <table cellpadding="0" cellspacing="0" role="presentation">
          <tr>
            <td style="font-size: 12px; color: #a1a1aa; padding: 4px 0; width: 90px; vertical-align: top;">Previous</td>
            <td style="font-size: 13px; color: #27272a; padding: 4px 0; font-weight: 500;">{{oldEmail}}</td>
          </tr>
          <tr>
            <td style="font-size: 12px; color: #a1a1aa; padding: 4px 0; width: 90px; vertical-align: top;">Updated to</td>
            <td style="font-size: 13px; color: #27272a; padding: 4px 0; font-weight: 500;">{{newEmail}}</td>
          </tr>
        </table>
      </td>
    </tr>
  </table>

  {{> info-alert message="If you did not make this change, contact our support team immediately and use the link below to revert it." type="critical"}}

  {{> action-button buttonText="Revert this change" buttonUrl=revertUrl}}

{{/layouts/base}}
