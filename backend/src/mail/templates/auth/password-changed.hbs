{{#> layouts/base title="Password changed" subject="Your password has been changed — Gravitest"}}

  <p style="font-size: 15px; color: #3f3f46; line-height: 1.7; margin: 0 0 8px;">
    Your Gravitest account password was successfully updated.
  </p>

  {{#if deviceName}}
    {{> security-alert
        alertMessage="This change was made from"
        deviceName=deviceName
        browser=browser
        ipAddress=ipAddress
        time=time}}
  {{/if}}

  {{> info-alert message="If you did not make this change, reset your password immediately and contact our support team." type="critical"}}

  {{> action-button buttonText="Review account security" buttonUrl=securityUrl}}

{{/layouts/base}}
