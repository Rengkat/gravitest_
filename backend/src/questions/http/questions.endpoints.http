### ─── 1. CREATE MCQ QUESTION (WAEC Mathematics) ──────────────────────────────
POST {{baseUrl}}/questions
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "examType": "waec",
  "subject": "mathematics",
  "year": 2020,
  "questionText": "If 2x + 3 = 11, find the value of x.",
  "difficulty": "easy",
  "type": "mcq",
  "topic": "Algebra",
  "isActive": false,
  "options": [
    { "label": "A", "text": "3", "order": 0 },
    { "label": "B", "text": "4", "order": 1 },
    { "label": "C", "text": "5", "order": 2 },
    { "label": "D", "text": "6", "order": 3 }
  ],
  "answer": { "correctLabel": "B" },
  "explanations": [
    {
      "text": "2x + 3 = 11 → 2x = 11 - 3 → 2x = 8 → x = 4. Therefore the answer is B (4).",
      "videoUrl": null,
      "imageUrl": null
    }
  ]
}

### ─── 2. CREATE MCQ QUESTION (JAMB Physics) ──────────────────────────────────
POST {{baseUrl}}/questions
Content-Type: {{contentType}}
Authorization: Bearer {{token}}
{
  "examType": "jamb",
  "subject": "physics",
  "year": 2021,
  "questionText": "Which of the following is a vector quantity?",
  "difficulty": "easy",
  "type": "mcq",
  "topic": "Scalar and Vector Quantities",
  "isActive": false,
  "options": [
    { "label": "A", "text": "Mass", "order": 0 },
    { "label": "B", "text": "Temperature", "order": 1 },
    { "label": "C", "text": "Velocity", "order": 2 },
    { "label": "D", "text": "Speed", "order": 3 }
  ],
  "answer": { "correctLabel": "C" },
  "explanations": [
    {
      "text": "Velocity is a vector quantity because it has both magnitude and direction. Mass, temperature, and speed are scalar quantities.",
      "videoUrl": null,
      "imageUrl": null
    }
  ]
}

### ─── 3. CREATE MCQ QUESTION (WAEC Chemistry - Medium) ───────────────────────
POST {{baseUrl}}/questions
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "examType": "waec",
  "subject": "chemistry",
  "year": 2019,
  "questionText": "What is the oxidation state of sulphur in H₂SO₄?",
  "difficulty": "medium",
  "type": "mcq",
  "topic": "Oxidation and Reduction",
  "isActive": false,
  "options": [
    { "label": "A", "text": "+2", "order": 0 },
    { "label": "B", "text": "+4", "order": 1 },
    { "label": "C", "text": "+6", "order": 2 },
    { "label": "D", "text": "-2", "order": 3 }
  ],
  "answer": { "correctLabel": "C" },
  "explanations": [
    {
      "text": "In H₂SO₄: H is +1 (×2 = +2), O is -2 (×4 = -8). So S must be +6 to balance: +2 + S + (-8) = 0 → S = +6.",
      "videoUrl": null,
      "imageUrl": null
    }
  ]
}

