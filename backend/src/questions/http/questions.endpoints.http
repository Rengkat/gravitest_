### ─── 17. UPDATE OPTIONS + ANSWER (atomic replace) ─────────────────────────
PATCH {{baseUrl}}/questions/{{questionId}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "options": [
    { "label": "A", "text": "2", "order": 0 },
    { "label": "B", "text": "4", "order": 1 },
    { "label": "C", "text": "6", "order": 2 },
    { "label": "D", "text": "8", "order": 3 }
  ],
  "answer": { "correctLabel": "B" }
}

