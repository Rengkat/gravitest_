### ─── 5. CREATE THEORY QUESTION (WAEC Biology) ──────────────────────────────
POST {{baseUrl}}/questions
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "examType": "waec",
  "subject": "biology",
  "year": 2020,
  "questionNumber": "1a",
  "questionText": "State THREE differences between mitosis and meiosis.",
  "difficulty": "medium",
  "type": "theory",
  "topic": "Cell Division",
  "isActive": false,
  "explanations": [
    {
      "text": "Mitosis: (1) Produces 2 daughter cells; (2) Daughter cells are diploid (2n); (3) Occurs in somatic cells. Meiosis: (1) Produces 4 daughter cells; (2) Daughter cells are haploid (n); (3) Occurs in reproductive cells.",
      "videoUrl": null,
      "imageUrl": null
    }
  ]
}

