### ─── 7. CREATE MCQ QUESTION ────────────────────────────────
POST {{baseUrl}}/questions
Content-Type: {{contentType}}
Authorization: Bearer {{token}}
{
  "examType": "waec",
  "subject": "mathematics",
  "year": 2025,
  "questionText": "Find the simple interest on ₦50,000 at 8% per annum for 3 years.",
  "difficulty": "medium",
  "type": "mcq",
  "topic": "Simple Interest",
  "isActive": false,
  "options": [
    { "label": "A", "text": "₦10,000", "order": 0 },
    { "label": "B", "text": "₦12,000", "order": 1 },
    { "label": "C", "text": "₦14,000", "order": 2 },
    { "label": "D", "text": "₦15,000", "order": 3 }
  ],
  "answer": { "correctLabel": "B" },
  "explanations": [
    {
      "text": "SI = (P × R × T) / 100 = (50000 × 8 × 3) / 100 = 1,200,000 / 100 = ₦12,000.",
      "videoUrl": null,
      "imageUrl": null
    }
  ]
}

