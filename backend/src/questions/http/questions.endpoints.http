### ─── 20. BULK IMPORT ────────────────────────────────────────────────────────
POST {{baseUrl}}/questions/bulk/import
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "questions": [
    {
      "examType": "jamb",
      "subject": "mathematics",
      "year": 2018,
      "questionText": "Simplify: (x² - 9) / (x - 3)",
      "difficulty": "medium",
      "type": "mcq",
      "topic": "Algebraic Fractions",
      "options": [
        { "label": "A", "text": "x - 3", "order": 0 },
        { "label": "B", "text": "x + 3", "order": 1 },
        { "label": "C", "text": "x² - 3", "order": 2 },
        { "label": "D", "text": "x + 9", "order": 3 }
      ],
      "answer": { "correctLabel": "B" },
      "explanations": [
        { "text": "(x² - 9) / (x - 3) = (x+3)(x-3) / (x-3) = x + 3" }
      ]
    },
    {
      "examType": "jamb",
      "subject": "mathematics",
      "year": 2018,
      "questionText": "If log₁₀ 2 = 0.3010, find log₁₀ 8.",
      "difficulty": "hard",
      "type": "mcq",
      "topic": "Logarithms",
      "options": [
        { "label": "A", "text": "0.6020", "order": 0 },
        { "label": "B", "text": "0.9030", "order": 1 },
        { "label": "C", "text": "1.2040", "order": 2 },
        { "label": "D", "text": "2.4080", "order": 3 }
      ],
      "answer": { "correctLabel": "B" },
      "explanations": [
        { "text": "log₁₀ 8 = log₁₀ 2³ = 3 × log₁₀ 2 = 3 × 0.3010 = 0.9030" }
      ]
    }
  ]
}

