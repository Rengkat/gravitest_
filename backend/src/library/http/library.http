### ─── 47. ADMIN LIST ALL (including drafts + inactive) ─────────────────────
GET {{baseUrl}}/library/admin/all
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

### ─── 48. ADMIN LIST — filter unpublished only ─────────────────────────────
GET {{baseUrl}}/library/admin/all?isPublished=false
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

### ─── 49. ADMIN LIST — filter inactive ─────────────────────────────────────
GET {{baseUrl}}/library/admin/all?isActive=false
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

### ─── 50. ADMIN LIST — filter premium tier content ─────────────────────────
GET {{baseUrl}}/library/admin/all?isFree=false
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

### ─── 51. ADMIN STATS ───────────────────────────────────────────────────────
GET {{baseUrl}}/library/admin/stats
Content-Type: {{contentType}}
Authorization: Bearer {{token}}


# =============================================================================
#  SECTION C — ADMIN: PUBLISH / UNPUBLISH / UPDATE / DELETE
# =============================================================================

### ─── 11. PUBLISH A CONTENT ITEM ───────────────────────────────────────────
PATCH {{baseUrl}}/library/{{contentId}}/publish
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

### ─── 12. UNPUBLISH A CONTENT ITEM ─────────────────────────────────────────
PATCH {{baseUrl}}/library/{{contentId}}/unpublish
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

### ─── 13. UPDATE METADATA (title + description) ────────────────────────────
PATCH {{baseUrl}}/library/{{contentId}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "title": "Complete WAEC Mathematics Guide 2024 (Revised Edition)",
  "description": "Updated with 2024 WAEC questions and new chapter on Statistics."
}

### ─── 14. UPDATE ACCESS MODEL — change from free to pay-per-item ────────────
### Note: server validates only one of isFree / requiredTier / priceKobo is set
PATCH {{baseUrl}}/library/cc70e253-73d2-4262-8e18-812d8af89450
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "isFree": false,
  "priceKobo": 75000
}

### ─── 15. UPDATE ACCESS MODEL — change to tier-gated ───────────────────────
PATCH {{baseUrl}}/library/{{contentId}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "isFree": false,
  "requiredTier": "standard"
}

### ─── 16. TOGGLE ACTIVE (deactivate without deleting) ──────────────────────
PATCH {{baseUrl}}/library/{{contentId}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "isActive": false
}

### ─── 17. SOFT DELETE (deactivate) ─────────────────────────────────────────
DELETE {{baseUrl}}/library/{{contentId}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

# =============================================================================
#  SECTION D — ADMIN: GRANT ACCESS MANUALLY
#  Use after confirming a manual bank transfer or for complimentary access
# =============================================================================

### ─── 43. GRANT ACCESS — permanent (no expiry) ─────────────────────────────
POST {{baseUrl}}/library/cc70e253-73d2-4262-8e18-812d8af89450/grant-access
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "userId": "{{userId}}",
  "paymentId": "MANUAL-PAY-2024-001"
}

### ─── 44. GRANT ACCESS — with expiry (30-day subscription window) ───────────
POST {{baseUrl}}/library/{{contentId}}/grant-access
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "userId": "{{userId}}",
  "paymentId": "PAY-TRX-20240315-ABC",
  "expiresAt": "2025-12-31T23:59:59.000Z"
}

### ─── 45. GRANT ACCESS — complimentary (no payment reference) ───────────────
POST {{baseUrl}}/library/{{contentId}}/grant-access
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "userId": "{{userId}}"
}

### ─── 46. RE-GRANT ACCESS — extends expiry on re-purchase ───────────────────
### Same userId + contentId as a previous grant — service refreshes expiresAt
POST {{baseUrl}}/library/{{contentId}}/grant-access
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "userId": "{{userId}}",
  "paymentId": "PAY-TRX-20241201-XYZ",
  "expiresAt": "2026-12-31T23:59:59.000Z"
}

