### ─── 1. CREATE FREE E-BOOK (Mathematics, WAEC, Secondary) ─────────────────
POST {{baseUrl}}/library
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "title": "Complete WAEC Mathematics Guide 2024",
  "description": "A comprehensive e-book covering all WAEC Mathematics topics from 2010–2024. Includes worked examples, past questions, and exam strategies.",
  "contentType": "ebook",
  "subject": "mathematics",
  "topic": "General Mathematics",
  "fileUrl": "https://cdn.gravitest.com/library/ebooks/waec-maths-2024.pdf",
  "thumbnailUrl": "https://cdn.gravitest.com/thumbs/waec-maths-2024.jpg",
  "totalPages": 340,
  "fileSizeBytes": 8388608,
  "examTypes": ["waec", "neco"],
  "classLevels": ["ss2", "ss3"],
  "isFree": true
}

